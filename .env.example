# Frontend
# Em produção na Vercel, o padrão agora é usar /api com rewrite.
# Só preencha VITE_API_URL se quiser apontar diretamente para outro backend.
VITE_API_URL=

# Backend — configurar no Dokploy / Docker como env vars
DATABASE_URL=postgresql://user:pass@host:5432/fotoagenda
SECRET_KEY=troque-por-chave-aleatoria-longa
HERMES_API_URL=https://api.meuchat.fbautomacao.space
HERMES_EMAIL=hermesadmin@fbautomacao.space
HERMES_PASSWORD=HermesAdmin@2026#Segura

# Kairos Admin — integração de licença
# Obtenha o KAIROS_CLIENT_ID registrando este app no painel Kairos Admin
KAIROS_ADMIN_URL=https://admin.fbautomacao.space
KAIROS_CLIENT_ID=
APP_SLUG=foto-agenda-pro

# Super Admin seed (opcional — cria usuário super_admin no primeiro boot)
ADMIN_EMAIL=
ADMIN_PASSWORD=
